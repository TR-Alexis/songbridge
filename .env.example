# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/songbridge?schema=public

# Spotify OAuth
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/auth/spotify/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/auth/google/callback

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h

# Optional: dedicated secret for encrypting provider tokens (falls back to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret

# YouTube API key (optional for public searches)
YOUTUBE_API_KEY=your_youtube_api_key

# Web
WEB_URL=https://your-ngrok-domain.ngrok-free.dev
# Leave empty so browser requests use the current origin and Next.js proxy.
NEXT_PUBLIC_API_URL=

# API
API_URL=http://localhost:4000
