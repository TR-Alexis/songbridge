generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  spotifyId      String   @unique
  email          String?  @unique
  displayName    String?
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MatchHistory {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  spotifyUri  String
  spotifyUrl  String
  title       String
  artist      String
  album       String?
  youtubeUrl  String?
  sourceType  String
  createdAt   DateTime @default(now())
}
